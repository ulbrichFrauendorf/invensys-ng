{
  "name": "invensys-ng",
  "version": "21.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:with-mcp": "node tools/mcp/run-with-ui.mjs",
    "mcp": "node tools/mcp/invensys-ng-mcp-server.mjs --http",
    "mcp:stdio": "node tools/mcp/invensys-ng-mcp-server.mjs --stdio",
    "build": "ng build invensys-ng && ng build ui-kit && npm run build:mcp-catalog",
    "build:mcp-catalog": "node tools/mcp/generate-catalog.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:page-layout": "ng test invensys-ng --watch=false --runner-config=projects/invensys-ng/vitest.frontend.config.mts --ts-config=projects/invensys-ng/tsconfig.page-layout.spec.json --include=lib/components/page-layout/page-layout.component.spec.ts --include=lib/components/layout/layout.component.spec.ts",
    "test:frontend": "ng test invensys-ng --watch=false --runner-config=projects/invensys-ng/vitest.frontend.config.mts --ts-config=projects/invensys-ng/tsconfig.mobile.spec.json --include=lib/components/mobile-controls.spec.ts --include=lib/components/frontend-consistency.spec.ts",
    "test:file-upload": "ng test invensys-ng --watch=false --ts-config=projects/invensys-ng/tsconfig.file-upload.spec.json --include=lib/components/file-upload/file-upload.component.spec.ts",
    "test:reporting": "ng test invensys-ng --watch=false --ts-config=projects/invensys-ng/tsconfig.reporting.spec.json --include=lib/components/button/button.component.spec.ts --include=lib/components/dialog/inner/dialog-actions/dialog-actions.component.spec.ts --include=lib/components/stepper/stepper.component.spec.ts --include=lib/components/table/table-actions.component.spec.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "baseline-browser-mapping": "^2.11.29",
    "chart.js": "^4.5.1",
    "ng-packagr": "^22.2.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "jsdom": "^30.1.3"
  },
  "overrides": {
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
